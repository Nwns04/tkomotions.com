# Shared database and secure staff session (also used by Finance).
MONGODB_URI=mongodb://127.0.0.1:27017/tko_motions
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:5173

# Finance API stays on its own origin. Do not point Sales Engine traffic at /api.
FINANCE_PORT=4000

# TKO AI Sales Engine. Keys stay server-side.
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=20000

RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Controlled TKO inbox for public TKO Properties demo leads. Leave empty to
# store leads without sending email.
DEMO_NOTIFICATION_EMAIL=
